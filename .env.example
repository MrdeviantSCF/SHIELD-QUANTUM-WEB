# SHIELD QUANTUM MACHINE & TECHNOLOGY
# Environment Variables Example
# Copy to .env.local for local overrides.

# Optional: Public site URL for metadata Base & Canonical URLs (Default: https://shieldquantum.ai)
NEXT_PUBLIC_SITE_URL=https://shieldquantum.ai

# Optional: Custom subpath if deployed under a specific path prefix (Default: empty for Vercel root)
NEXT_PUBLIC_BASE_PATH=

# Optional: Set to true if generating a static export folder ('out') locally
EXPORT_STATIC=false
